# Copy to config.toml. Credentials remain local and are never included in Docker images.
[vpn]
host = "vpn.example.com"
user = "your-username"
password = "your-vpn-password"
group = ""
# Blank uses the corporate DNS addresses provided by the VPN server.
dns_server = ""
# Reconnect transport with the existing session only. Never repeat MFA/password login.
auto_reconnect = false

[docker]
image = "split-vpn-router:local"
api_port = 8889
relay_port = 1080

[routing]
# Pause outbound-adapter IP forwarding while routing, then restore it on stop/crash.
# Opt in if Windows reports a forwarding conflict (hotspot/router use may pause).
manage_forwarding = false
# direct-default: home network unless vpn.list matches.
# vpn-default: VPN unless direct.list matches. VPN rules always take precedence.
mode = "direct-default"
# Home/public resolver used for direct destinations. Set to your LAN DNS if required.
direct_dns = "1.1.1.1"
